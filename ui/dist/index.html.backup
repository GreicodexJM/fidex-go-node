<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - FideX Edge Node</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>
</head>
<body class="bg-slate-50">
    <!-- Header -->
    <nav class="bg-white shadow-sm border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center">
                        <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                            </svg>
                        </div>
                        <span class="ml-3 text-xl font-bold text-slate-900">FideX Edge Node</span>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="text-sm text-slate-600">Logged in as <strong id="username">admin</strong></span>
                    <button onclick="logout()" class="px-4 py-2 text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition">
                        Logout
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Metrics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
            <!-- Messages Delivered -->
            <div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-600">Delivered (24h)</p>
                        <p id="metric-delivered" class="text-3xl font-bold text-slate-900 mt-2">0</p>
                    </div>
                    <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Messages Queued -->
            <div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-600">Queued</p>
                        <p id="metric-queued" class="text-3xl font-bold text-slate-900 mt-2">0</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Messages Failed -->
            <div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-600">Failed</p>
                        <p id="metric-failed" class="text-3xl font-bold text-slate-900 mt-2">0</p>
                    </div>
                    <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Success Rate -->
            <div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-600">Success Rate</p>
                        <p id="metric-success" class="text-3xl font-bold text-slate-900 mt-2">0%</p>
                    </div>
                    <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Active Partners -->
            <div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-600">Partners</p>
                        <p id="metric-partners" class="text-3xl font-bold text-slate-900 mt-2">0</p>
                    </div>
                    <div class="w-12 h-12 bg-amber-100 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left Column: QR Code & Partner Discovery -->
            <div class="space-y-6">
                <!-- QR Code Card -->
                <div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200">
                    <h3 class="text-lg font-bold text-slate-900 mb-4">Partner Onboarding QR</h3>
                    <div class="flex flex-col items-center">
                        <img id="qr-code" src="/api/dashboard/qr?size=256" alt="QR Code" class="w-64 h-64 border-4 border-slate-200 rounded-lg">
                        <p class="text-sm text-slate-600 mt-4 text-center">Partners scan this to auto-discover your node</p>
                        <button onclick="downloadQR()" class="mt-4 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition text-sm font-medium">
                            Download QR Code
                        </button>
                    </div>
                </div>

                <!-- Discover Partner Card -->
                <div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200">
                    <h3 class="text-lg font-bold text-slate-900 mb-4">Discover Partner</h3>
                    
                    <!-- Manual URL Input -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-2">Discovery URL</label>
                        <input type="text" id="discovery-url" placeholder="https://partner.com/.well-known/as5-configuration" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none text-sm">
                        <button onclick="discoverPartner()" class="mt-3 w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition text-sm font-medium">
                            Discover Partner
                        </button>
                    </div>

                    <div class="border-t border-slate-200 my-4"></div>

                    <!-- QR Scanner -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-2">Or Scan Partner's QR</label>
                        <div id="qr-reader" class="w-full rounded-lg overflow-hidden border border-slate-300"></div>
                        <button onclick="startScanner()" id="scan-btn" class="mt-3 w-full px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-sm font-medium">
                            Start Scanner
                        </button>
                    </div>

                    <!-- Discovery Status -->
                    <div id="discovery-status" class="hidden mt-4 p-4 rounded-lg"></div>
                </div>
            </div>

            <!-- Right Column: Messages & Partners -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Trading Partners -->
                <div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200">
                    <h3 class="text-lg font-bold text-slate-900 mb-4">Trading Partners</h3>
                    <div id="partners-list" class="space-y-3">
                        <p class="text-sm text-slate-500 text-center py-8">Loading partners...</p>
                    </div>
                </div>

                <!-- Recent Messages -->
                <div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200">
                    <h3 class="text-lg font-bold text-slate-900 mb-4">Recent Messages</h3>
                    <div id="messages-list" class="space-y-3">
                        <p class="text-sm text-slate-500 text-center py-8">Loading messages...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- WebSocket Status Indicator -->
    <div id="ws-status" class="fixed bottom-4 right-4 px-4 py-2 rounded-lg shadow-lg text-sm font-medium">
        <span class="inline-block w-2 h-2 rounded-full mr-2"></span>
        <span id="ws-text">Connecting...</span>
    </div>

    <script>
        let ws = null;
        let scanner = null;
        let scannerStarted = false;

        // Initialize on load
        document.addEventListener('DOMContentLoaded', () => {
            loadMetrics();
            loadPartners();
            loadMessages();
            connectWebSocket();
            
            // Refresh metrics every 30 seconds
            setInterval(loadMetrics, 30000);
        });

        // Load Metrics
        async function loadMetrics() {
            try {
                const response = await fetch('/api/dashboard/metrics');
                const data = await response.json();
                
                document.getElementById('metric-delivered').textContent = data.messages_delivered_24h || 0;
                document.getElementById('metric-queued').textContent = data.messages_queued || 0;
                document.getElementById('metric-failed').textContent = data.messages_failed || 0;
                document.getElementById('metric-success').textContent = ((data.success_rate || 0) * 100).toFixed(1) + '%';
                document.getElementById('metric-partners').textContent = data.active_partners || 0;
            } catch (error) {
                console.error('Failed to load metrics:', error);
            }
        }

        // Load Trading Partners
        async function loadPartners() {
            try {
                const response = await fetch('/api/dashboard/partners');
                const data = await response.json();
                const partnersList = document.getElementById('partners-list');
                
                if (data.partners && data.partners.length > 0) {
                    partnersList.innerHTML = data.partners.map(partner => `
                        <div class="flex items-center justify-between p-4 bg-slate-50 rounded-lg border border-slate-200">
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
                                    <span class="text-white font-bold text-sm">${partner.name.substring(0, 2).toUpperCase()}</span>
                                </div>
                                <div>
                                    <p class="font-medium text-slate-900">${partner.name}</p>
                                    <p class="text-xs text-slate-500">${partner.partner_id}</p>
                                </div>
                            </div>
                            <span class="px-3 py-1 text-xs font-medium text-green-700 bg-green-100 rounded-full">Connected</span>
                        </div>
                    `).join('');
                } else {
                    partnersList.innerHTML = '<p class="text-sm text-slate-500 text-center py-8">No partners yet. Scan a QR code to add one!</p>';
                }
            } catch (error) {
                console.error('Failed to load partners:', error);
            }
        }

        // Load Recent Messages
        async function loadMessages() {
            try {
                const response = await fetch('/api/dashboard/messages?limit=10');
                const data = await response.json();
                const messagesList = document.getElementById('messages-list');
                
                if (data.messages && data.messages.length > 0) {
                    messagesList.innerHTML = data.messages.map(msg => `
                        <div class="flex items-center justify-between p-4 bg-slate-50 rounded-lg border border-slate-200">
                            <div class="flex-1">
                                <div class="flex items-center space-x-2">
                                    <span class="text-xs font-mono text-slate-500">${msg.message_id.substring(0, 8)}...</span>
                                    <span class="px-2 py-0.5 text-xs font-medium rounded ${msg.direction === 'INBOUND' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}">${msg.direction}</span>
                                </div>
                                <p class="text-xs text-slate-500 mt-1">${new Date(msg.created_at).toLocaleString()}</p>
                            </div>
                            <span class="px-3 py-1 text-xs font-medium rounded ${getStatusColor(msg.status)}">${msg.status}</span>
                        </div>
                    `).join('');
                } else {
                    messagesList.innerHTML = '<p class="text-sm text-slate-500 text-center py-8">No messages yet</p>';
                }
            } catch (error) {
                console.error('Failed to load messages:', error);
            }
        }

        function getStatusColor(status) {
            const colors = {
                'DELIVERED': 'bg-green-100 text-green-700',
                'QUEUED': 'bg-blue-100 text-blue-700',
                'FAILED': 'bg-red-100 text-red-700',
                'PROCESSING': 'bg-yellow-100 text-yellow-700'
            };
            return colors[status] || 'bg-slate-100 text-slate-700';
        }

        // WebSocket Connection
        function connectWebSocket() {
            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            ws = new WebSocket(`${protocol}//${window.location.host}/api/dashboard/ws`);
            
            ws.onopen = () => {
                updateWSStatus('connected', 'Connected');
            };
            
            ws.onmessage = (event) => {
                const msg = JSON.parse(event.data);
                handleWebSocketMessage(msg);
            };
            
            ws.onerror = () => {
                updateWSStatus('error', 'Connection Error');
            };
            
            ws.onclose = () => {
                updateWSStatus('disconnected', 'Disconnected');
                // Reconnect after 5 seconds
                setTimeout(connectWebSocket, 5000);
            };
        }

        function handleWebSocketMessage(msg) {
            console.log('WebSocket message:', msg);
            
            if (msg.type === 'partner_added') {
                loadPartners();
                loadMetrics();
            } else if (msg.type === 'message_new' || msg.type === 'message_status') {
                loadMessages();
                loadMetrics();
            }
        }

        function updateWSStatus(status, text) {
            const statusDiv = document.getElementById('ws-status');
            const statusText = document.getElementById('ws-text');
            const dot = statusDiv.querySelector('.inline-block');
            
            statusText.textContent = text;
            
            if (status === 'connected') {
                statusDiv.className = 'fixed bottom-4 right-4 px-4 py-2 rounded-lg shadow-lg text-sm font-medium bg-green-100 text-green-800';
                dot.className = 'inline-block w-2 h-2 rounded-full mr-2 bg-green-500';
            } else if (status === 'error') {
                statusDiv.className = 'fixed bottom-4 right-4 px-4 py-2 rounded-lg shadow-lg text-sm font-medium bg-red-100 text-red-800';
                dot.className = 'inline-block w-2 h-2 rounded-full mr-2 bg-red-500';
            } else {
                statusDiv.className = 'fixed bottom-4 right-4 px-4 py-2 rounded-lg shadow-lg text-sm font-medium bg-yellow-100 text-yellow-800';
                dot.className = 'inline-block w-2 h-2 rounded-full mr-2 bg-yellow-500';
            }
        }

        // Discover Partner
        async function discoverPartner() {
            const url = document.getElementById('discovery-url').value.trim();
            const statusDiv = document.getElementById('discovery-status');
            
            if (!url) {
                showDiscoveryStatus('error', 'Please enter a discovery URL');
                return;
            }
            
            statusDiv.innerHTML = '<p class="text-sm text-blue-700"><span class="animate-pulse">⏳</span> Discovering partner...</p>';
            statusDiv.className = 'mt-4 p-4 rounded-lg bg-blue-50';
            statusDiv.classList.remove('hidden');
            
            try {
                const response = await fetch('/api/dashboard/partners/discover', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({discovery_url: url})
                });
                
                const data = await response.json();
                
                if (response.ok) {
                    showDiscoveryStatus('success', `✅ Partner "${data.name}" discovered and added!`);
                    document.getElementById('discovery-url').value = '';
                    loadPartners();
                    loadMetrics();
                } else {
                    showDiscoveryStatus('error', `❌ ${data.error || 'Failed to discover partner'}`);
                }
            } catch (error) {
                showDiscoveryStatus('error', `❌ Network error: ${error.message}`);
            }
        }

        function showDiscoveryStatus(type, message) {
            const statusDiv = document.getElementById('discovery-status');
            statusDiv.innerHTML = `<p class="text-sm">${message}</p>`;
            statusDiv.className = `mt-4 p-4 rounded-lg ${type === 'success' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'}`;
            statusDiv.classList.remove('hidden');
            
            setTimeout(() => {
                statusDiv.classList.add('hidden');
            }, 5000);
        }

        // QR Scanner
        function startScanner() {
            if (scannerStarted) {
                scanner.stop();
                document.getElementById('scan-btn').textContent = 'Start Scanner';
                document.getElementById('scan-btn').className = 'mt-3 w-full px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-sm font-medium';
                scannerStarted = false;
                return;
            }
            
            scanner = new Html5QrcodeScanner("qr-reader", { fps: 10, qrbox: 250 });
            scanner.render(onScanSuccess, onScanError);
            document.getElementById('scan-btn').textContent = 'Stop Scanner';
            document.getElementById('scan-btn').className = 'mt-3 w-full px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition text-sm font-medium';
            scannerStarted = true;
        }

        function onScanSuccess(decodedText) {
            scanner.clear();
            document.getElementById('discovery-url').value = decodedText;
            document.getElementById('scan-btn').textContent = 'Start Scanner';
            document.getElementById('scan-btn').className = 'mt-3 w-full px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-sm font-medium';
            scannerStarted = false;
            discoverPartner();
        }

        function onScanError(error) {
            // Ignore scan errors (they happen continuously while scanning)
        }

        // Download QR Code
        function downloadQR() {
            const link = document.createElement('a');
            link.href = '/api/dashboard/qr?size=512';
            link.download = 'fidex-partner-qr.png';
            link.click();
        }

        // Logout
        async function logout() {
            try {
                await fetch('/api/auth/logout', {method: 'POST'});
                window.location.href = '/login';
            } catch (error) {
                console.error('Logout failed:', error);
                window.location.href = '/login';
            }
        }
    </script>
</body>
</html>
